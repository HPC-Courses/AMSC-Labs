#!/bin/bash
#PBS -q cpu
#PBS -l select=1:ncpus=4:mpiprocs=4
#PBS -l walltime=00:05:00
#PBS -N hello_mpi

# The job starts in your home: move to the folder where you ran qsub
cd $PBS_O_WORKDIR

# Everything this script prints goes to this file, errors included
exec &> hello_mpi.$PBS_JOBID.out

# The compiler and Open MPI
source /software/spack/share/spack/setup-env.sh
spack load gcc@15.2.0
spack load openmpi@5.0.8

# Each job has its own executable: two jobs in this folder may run at the same time
mpic++ -Wall -std=c++20 solution.cpp -o solution.$PBS_JOBID
mpirun -n 4 ./solution.$PBS_JOBID
rm solution.$PBS_JOBID
